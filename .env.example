# Copy this file to .env and fill in as needed.

# --- Database ---
# Local dev: point this at a free Postgres instance (Vercel Postgres, Neon, Supabase, etc).
# SQLite is not used in production because serverless platforms like Vercel
# don't persist local files between requests.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Market data provider ---
# "mock" requires no API key. "fmp" (Financial Modeling Prep) is the
# implemented real provider — get a free key at
# https://site.financialmodelingprep.com/ and set FMP_API_KEY below.
MARKET_DATA_PROVIDER="mock"
FMP_API_KEY=

# --- Fundamentals (financial statements) provider ---
# Separate switch from MARKET_DATA_PROVIDER, reuses the same FMP_API_KEY
# above. "mock" generates internally-consistent fake financials.
FUNDAMENTALS_DATA_PROVIDER="mock"
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- Reserved for later phases ---
NEWS_API_KEY=
SEC_EDGAR_USER_AGENT=
ANTHROPIC_API_KEY=

# --- Logging ---
LOG_LEVEL="info"

# --- Site password gate (optional) ---
# If set, every page and API route requires this password (see
# src/middleware.ts). Leave blank to keep the site fully open.
SITE_PASSWORD=

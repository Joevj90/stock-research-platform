{
  "name": "stock-research-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "backtest:download": "tsx scripts/backtest/download.ts",
    "backtest:cases": "tsx scripts/backtest/cases.ts",
    "backtest:universe": "node --max-old-space-size=6144 --import tsx scripts/backtest/universe.ts",
    "check:alpaca": "tsx scripts/check-alpaca-provider.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "jsonrepair": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}

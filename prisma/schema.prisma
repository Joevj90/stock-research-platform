// Prisma schema for the AI Stock Research Platform.
//
// Phase 1 note: only Stock + PriceBar are actively written to by the app.
// Financials, Filing, NewsItem, Analysis, Forecast, and Source are modeled
// now so later phases (fundamentals, filings, news/sentiment, AI analysts,
// investment committee, forecasts, citations) have a stable schema to land
// on without migrations that reshape data the UI already depends on.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A covered security, keyed by ticker. Never seeded with hardcoded
/// per-ticker facts — rows are created on first lookup.
model Stock {
  id        String   @id @default(cuid())
  ticker    String   @unique
  name      String?
  exchange  String?
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceBars    PriceBar[]
  quotes       Quote[]
  cacheEntries MarketDataCacheEntry[]
  financials   Financials[]
  fundamentalsCacheEntries FundamentalsCacheEntry[]
  filings      Filing[]
  newsItems    NewsItem[]
  newsCacheEntries NewsCacheEntry[]
  insiderTransactions InsiderTransaction[]
  insiderTradingCacheEntries InsiderTradingCacheEntry[]
  analyses     Analysis[]
  forecasts    Forecast[]

  @@map("stocks")
}

/// A single OHLCV bar (daily by default). Source of historical price data.
/// `provider` + `retrievedAt` + the Stock relation (ticker) together satisfy
/// the "every piece of market data has a source, retrieval timestamp, and
/// ticker" requirement at the row level.
model PriceBar {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  timestamp   DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float
  interval    String // "1d" | "1wk" | "1mo" (extendable to intraday later)
  provider    String // e.g. "mock", "fmp", "alpha_vantage", "finnhub"
  retrievedAt DateTime @default(now())

  @@unique([stockId, timestamp, interval])
  @@index([stockId, timestamp])
  @@map("price_bars")
}

/// A point-in-time quote/fundamentals snapshot (price, previous close,
/// market cap, 52-week high/low, average volume). One row per fetch, so
/// `quote history` is naturally preserved rather than overwritten.
model Quote {
  id            String   @id @default(cuid())
  stockId       String
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  price         Float
  change        Float
  changePercent Float
  dayHigh       Float
  dayLow        Float
  previousClose Float
  volume        Float
  marketCap     Float?
  week52High    Float?
  week52Low     Float?
  avgVolume     Float?
  provider      String
  retrievedAt   DateTime @default(now())

  @@index([stockId, retrievedAt])
  @@map("quotes")
}

/// The cache index for market-data fetches. One row per (stock, data type,
/// period) tracks when that slice of data was last retrieved from an
/// external provider, so the market-data service can decide "serve from DB"
/// vs. "call the provider again" without re-deriving coverage from the raw
/// PriceBar/Quote rows every time. This is also the explicit, queryable
/// record of source + retrieval timestamp + ticker + period for every piece
/// of market data the app has ever fetched.
model MarketDataCacheEntry {
  id          String    @id @default(cuid())
  stockId     String
  stock       Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  dataType    String // "quote" | "historical"
  // HistoricalPeriod ("1M".."5Y") for dataType "historical"; the sentinel
  // "REALTIME" for dataType "quote". Deliberately non-null: Postgres treats
  // NULL as distinct in unique constraints, which would silently break the
  // one-row-per-(stock,dataType) guarantee for quotes if this were nullable.
  period      String
  provider    String
  retrievedAt DateTime  @default(now())
  rangeStart  DateTime?
  rangeEnd    DateTime?

  @@unique([stockId, dataType, period])
  @@map("market_data_cache_entries")
}

/// A reported financial statement period (income statement + balance
/// sheet + cash flow statement, merged into one row per reporting
/// period). Populated by the fundamentals data layer (Step 5).
/// Every row carries full provenance: source, filingDate, fiscalYear,
/// fiscalQuarter, and retrievedAt — never an unattributed data point.
model Financials {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // --- Metadata / provenance ---
  periodEnd     DateTime // the reporting period's end date
  periodType    String   // "annual" | "quarterly" — never mixed in one query
  fiscalYear    Int
  fiscalQuarter Int?     // null for annual periods
  filingDate    DateTime?
  reportedCurrency String?
  provider      String
  retrievedAt   DateTime @default(now())

  // --- Income statement ---
  revenue         Float?
  grossProfit     Float?
  operatingIncome Float?
  netIncome       Float?
  eps             Float?

  // --- Balance sheet ---
  cash               Float?
  totalAssets        Float?
  totalLiabilities   Float?
  totalDebt          Float?
  shareholdersEquity Float?

  // --- Cash flow statement ---
  operatingCashFlow   Float?
  capitalExpenditures Float?
  freeCashFlow        Float?

  // --- Step 8 additions (Valuation Engine) ---
  ebitda              Float?
  dividendsPaid       Float?

  // Deterministic validation findings for this period (see
  // src/server/fundamentals/validate.ts), stored as a JSON array so the
  // UI can surface data-quality flags without re-running validation.
  validationWarnings String? // JSON-encoded ValidationWarning[]

  @@unique([stockId, periodEnd, periodType])
  @@index([stockId, periodType, fiscalYear])
  @@map("financials")
}

/// Cache index for fundamentals fetches — mirrors MarketDataCacheEntry.
/// One row per (stock, periodType): fundamentals are fetched as a whole
/// history in one call, so caching is scoped at that granularity rather
/// than per individual period.
model FundamentalsCacheEntry {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  periodType  String   // "annual" | "quarterly"
  provider    String
  retrievedAt DateTime @default(now())

  @@unique([stockId, periodType])
  @@map("fundamentals_cache_entries")
}

/// SEC filing metadata (10-K, 10-Q, 8-K, etc). Populated in a later phase.
model Filing {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  filingType  String // "10-K" | "10-Q" | "8-K" | ...
  filedAt     DateTime
  url         String
  summary     String?
  provider    String
  createdAt   DateTime @default(now())

  @@index([stockId, filedAt])
  @@map("filings")
}

/// A news item relevant to the company or its industry. Populated in a later phase.
/// A retrieved news article for a company (real data only — see
/// src/server/news for the provider that populates this). The AI's
/// classification (bullish/bearish/neutral, importance, grouping) is
/// computed on demand and NOT persisted here, same pattern as the
/// Technical Analysis Agent and Fundamental Analyst — only the raw fetched
/// facts are stored; every field below is exactly what a provider
/// returned, never AI-modified.
model NewsItem {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  url         String
  publishedAt DateTime
  sourceName  String
  sourceType  String? // e.g. "press_release", "financial_news" — provider-classified where available
  summary     String? // short snippet/description from the provider, if any
  provider    String
  retrievedAt DateTime @default(now())

  @@unique([stockId, url])
  @@index([stockId, publishedAt])
  @@map("news_items")
}

/// Cache index for news fetches — mirrors MarketDataCacheEntry /
/// FundamentalsCacheEntry. One row per stock: a news fetch retrieves a
/// batch of recent articles in one call, so caching is scoped at that
/// granularity.
model NewsCacheEntry {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  provider    String
  retrievedAt DateTime @default(now())

  @@unique([stockId])
  @@map("news_cache_entries")
}

/// A single real insider-trading transaction (SEC Form 4 disclosure),
/// used by the Management Analysis agent (Step 12). Every field is
/// exactly what a provider returned — never AI-modified. `url` links to
/// the real SEC filing where available, satisfying "preserve source URLs
/// and dates" and "never fabricate ... transactions".
model InsiderTransaction {
  id                String   @id @default(cuid())
  stockId           String
  stock             Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  reportingName     String // the insider's name, as reported
  role              String? // e.g. "officer: CFO", "director"
  transactionType   String // e.g. "purchase", "sale", "other" (normalized from raw filing codes)
  transactionDate   DateTime
  filingDate        DateTime
  shares            Float
  pricePerShare     Float?
  url               String? // link to the real SEC filing
  provider          String
  retrievedAt       DateTime @default(now())

  @@unique([stockId, reportingName, transactionDate, shares, transactionType])
  @@index([stockId, transactionDate])
  @@map("insider_transactions")
}

/// Cache index for insider-trading fetches — mirrors NewsCacheEntry.
model InsiderTradingCacheEntry {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  provider    String
  retrievedAt DateTime @default(now())

  @@unique([stockId])
  @@map("insider_trading_cache_entries")
}

/// Output of an AI analysis pass (single analyst, committee verdict, devil's
/// advocate critique, or final synthesized report — distinguished by `kind`).
/// Not written to in Phase 1; the AI analysis module is a stub.
model Analysis {
  id         String   @id @default(cuid())
  stockId    String
  stock      Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  kind       String // "analyst" | "committee" | "devils_advocate" | "final_report"
  agentName  String? // e.g. "value_analyst", "technical_analyst"
  summary    String
  confidence Float? // 0..1
  content    String // full structured output, JSON-encoded
  createdAt  DateTime @default(now())

  sources AnalysisSource[]

  @@index([stockId, kind, createdAt])
  @@map("analyses")
}

/// A 12-month (or other horizon) price forecast with bull/base/bear scenarios.
/// Not written to in Phase 1.
model Forecast {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  horizonDays Int
  bullTarget  Float?
  baseTarget  Float?
  bearTarget  Float?
  rationale   String?
  confidence  Float?
  createdAt   DateTime @default(now())

  @@index([stockId, createdAt])
  @@map("forecasts")
}

/// A citable source (filing, news article, data provider response) backing
/// an Analysis. Kept separate from NewsItem/Filing so an Analysis can cite
/// arbitrary external material, not just rows already in this DB.
model Source {
  id        String   @id @default(cuid())
  title     String
  url       String?
  publisher String?
  createdAt DateTime @default(now())

  analyses AnalysisSource[]

  @@map("sources")
}

/// Join table: which sources back which analysis.
model AnalysisSource {
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([analysisId, sourceId])
  @@map("analysis_sources")
}
